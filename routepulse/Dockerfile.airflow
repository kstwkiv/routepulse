FROM apache/airflow:2.7.0-python3.11

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# Install additional Python packages needed by DAGs
RUN pip install --no-cache-dir \
    psycopg2-binary==2.9.10 \
    duckdb==1.1.3 \
    pandas==2.2.3 \
    faker==33.1.0 \
    python-dotenv==1.0.1 \
    numpy==1.26.2

# Copy project source so DAGs can import etl/generator modules
COPY --chown=airflow:root . /opt/airflow/routepulse
ENV PYTHONPATH="/opt/airflow/routepulse:${PYTHONPATH}"
